<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
	<module name="TimeAllocationMutator">
		<param name="mutationRange" value="1800.0"/>
		<param name="mutateAroundInitialEndTimeOnly" value="true"/>
	</module>

	<module name="controller">
		<param name="lastIteration" value="30"/>
		<param name="overwriteFiles" value="failIfDirectoryExists"/>
		<param name="runId" value="oberlausitz-dresden-mini"/>
		<param name="outputDirectory" value="./output/output-oberlausitz-dresden-mini"/>
		<param name="writeEventsInterval" value="0"/>
		<param name="writePlansInterval" value="0"/>
		<param name="enableLinkToLinkRouting" value="false"/>
		<param name="routingAlgorithmType" value="SpeedyALT"/>
	</module>

	<!-- numberOfThreads (global/qsim/drt je Modus) auf 6 abgestimmt: Server hat
	     6 Kerne, DrtConfigGroup.numberOfThreads faellt sonst per Default auf
	     Runtime.getRuntime().availableProcessors() zurueck und wuerde bei
	     mehreren DRT-Modi (PSAV+SSAV) potenziell mehr Threads anfordern, als
	     tatsaechlich sinnvoll parallelisierbar sind.

	     global.numberOfThreads wird NUR von der DCM-Umplanung genutzt (QSim/DRT
	     haben je einen eigenen, unten separat gesetzten Wert von 6, siehe
	     qsim/multiModeDrt-Module) - war zwischenzeitlich auf 12 hochgesetzt,
	     dann wieder auf 6 zurueckgestellt: bei einem echten 10pct/40-Iterationen-
	     Lauf trat nach ~25 Iterationen (7h) ein Absturz auf (zwei DCM-Replanning-
	     Threads lasen GLEICHZEITIG denselben korrupten Link-Index -1543301172 an
	     zwei verschiedenen Stellen - TravelTimeCalculator fuer CA/AV-Routing UND
	     DvrpOfflineTravelTimeEstimator fuer PSAV/SSAV-Routing gleichzeitig -
	     klare Signatur einer Race Condition, vermutlich weil DRTs Routing-/
	     Reisezeit-Komponenten fuer DRTs EIGENE, kontrolliertere Dispatch-Logik
	     gebaut sind, nicht fuer den Aufruf aus 12 parallelen DCM-Replanning-
	     Threads gleichzeitig). Weniger Threads in der Umplanung senken die
	     Wahrscheinlichkeit, dieses seltene Zeitfenster zu treffen - kostet nur
	     die Umplanungsphase selbst (~2 von ~17 Min/Iteration im beobachteten
	     Lauf), nicht die QSim-/DRT-Simulation, die ohnehin schon bei 6 Threads
	     laeuft. -->
	<module name="global">
		<param name="coordinateSystem" value="EPSG:25832"/>
		<param name="insistingOnDeprecatedConfigVersion" value="false"/>
		<param name="numberOfThreads" value="6"/>
	</module>

	<module name="network">
		<param name="inputNetworkFile" value="https://svn.vsp.tu-berlin.de/repos/public-svn/matsim/scenarios/countries/de/oberlausitz-dresden/oberlausitz-dresden-v2025.0/input/oberlausitz-dresden-v2025.0-network-with-pt.xml.gz"/>
		<param name="laneDefinitionsFile" value="null"/>
	</module>

	<!-- Testweise auf 25pct hochgestellt (kurzer 2-3-Iterationen-Test vor einem
	     vollen 40-Iterationen-Lauf, um RAM-Verbrauch/Zeit pro Iteration zu
	     pruefen): flowCapacityFactor/storageCapacityFactor unten entsprechend
	     auf 0.25 gesetzt, muss bei jeder Aenderung der Populationsstufe
	     konsistent mitgezogen werden (siehe Git-History - genau diese
	     Inkonsistenz hatte vorher zu einer 10x zu hohen Netzkapazitaet
	     gefuehrt, siehe Commit f261b67). JAVA_XMX beim Start entsprechend
	     hoeher als die 26g fuer 10pct waehlen (siehe scripts/
	     run-oberlausitz-dresden.sh-Kommentar). -->
	<module name="plans">
		<param name="inputPlansFile"
		       value="https://svn.vsp.tu-berlin.de/repos/public-svn/matsim/scenarios/countries/de/oberlausitz-dresden/oberlausitz-dresden-v2025.0/input/oberlausitz-dresden-v2025.0-25pct.plans-initial.xml.gz"/>
		<param name="removingUnnecessaryPlanAttributes" value="true"/>
	</module>

	<module name="vehicles">
		<param name="vehiclesFile" value="https://svn.vsp.tu-berlin.de/repos/public-svn/matsim/scenarios/countries/de/oberlausitz-dresden/oberlausitz-dresden-v2025.0/input/oberlausitz-dresden-v2025.0-vehicle-types.xml"/>
	</module>

	<!-- ============================================================================
	     SAV-FLOTTE (Schritt 8, Betriebskonzepte korrigiert in Schritt 9): PSAV
	     und SSAV als echte DRT-Flotten (matsim-contrib "drt"/"dvrp") statt
	     reiner Netzwerk-Modi - mit Dispatch, Warteschlangen und Leerfahrten
	     (Rebalancing). Siehe alternatives.java fuer die Definitionen:

	       PSAV = gepoolt MIT virtuellen Haltestellen (wie MOIA) - mehrere
	              Fahrgaeste gleichzeitig an Bord, Zu-/Abgang zu Fuss zur
	              naechsten virtuellen Haltestelle statt Door-to-Door.
	              -> operationalScheme=stopbased, transitStopFile (siehe unten).
	       SSAV = Door-to-Door-Robotaxi OHNE Pooling - befoerdert immer nur
	              einen Kunden/eine Buchung gleichzeitig.
	              -> operationalScheme=door2door, capacity=1 (in
	              RunOberlausitzDresdenTest.SSAV_CAPACITY).

	     vehiclesFile/transitStopFile sind hier Platzhalter: behaviourModule.
	     prepareDrtFleets(...) ueberschreibt sie zur Laufzeit mit aus dem
	     tatsaechlich geladenen Netzwerk generierten Dateien (siehe
	     RunOberlausitzDresdenTest - Oberlausitz/Dresden hat keine statischen,
	     bekannten Link-IDs, das Netz wird je Lauf per HTTPS geladen).

	     Flottengroesse/Kapazitaet/Haltestellenzahl: siehe PSAV_FLEET_SIZE/
	     SSAV_FLEET_SIZE etc. in RunOberlausitzDresdenTest.java - PLATZHALTER,
	     nicht aus einer Bedarfsanalyse kalibriert. SSAV braucht (ohne Pooling)
	     deutlich mehr Fahrzeuge fuer dieselbe Nachfrage als PSAV.

	     maxWaitTime ist bei PSAV hoeher als bei SSAV: PSAV muss erst Fahrgaeste
	     gemeinsam zur Haltestelle routen/poolen (traegt mehr Wartezeit), SSAV
	     dispatcht direkt zum Kunden. maxTravelTimeAlpha/-Beta, stopDuration,
	     Rebalancing-Zonengroesse: PLATZHALTER, uebernommen als plausible
	     Startwerte aus den offiziellen MATSim-Beispielen (mielec_multiModeEdrt_
	     config.xml, mielec_stop_based_drt_config.xml).

	     Rebalancing (minCostFlowRebalancingStrategy): DAS ist der Mechanismus,
	     der die Leerfahrten erzeugt - Fahrzeuge werden proaktiv in Zonen mit
	     erwarteter Nachfrage vorpositioniert, nicht nur zwischen Absetzen und
	     naechster Anfrage leer bewegt. -->
	<module name="dvrp">
		<!-- networkModes explizit setzen (nicht nur car): noetig, damit
		     useModeFilteredSubnetwork=true je DRT-Modus (siehe unten) greift -
		     DVRP baut dann ein kleineres Routing-Netz nur aus Links, die
		     tatsaechlich psav/ssav erlauben, statt aus dem vollen 441.000-Link-Netz. -->
		<param name="networkModes" value="car,psav,ssav"/>

		<!-- travelTimeMatrix-Zonengroesse: PLATZHALTER. Oberlausitz/Dresden ist ein
		     grossflaechiges Metropolregion-Netz (~441.000 Links) - ohne dieses
		     Parameterset faellt DVRP auf eine viel zu feine Default-Zonierung
		     zurueck, die Matrix.<init> mit OutOfMemoryError abbrechen laesst
		     (selbst bei 11g Heap). -->
		<parameterset type="travelTimeMatrix">
			<parameterset type="SquareGridZoneSystem">
				<param name="cellSize" value="6000"/>
			</parameterset>
		</parameterset>
	</module>

	<module name="multiModeDrt">

		<parameterset type="drt">
			<parameterset type="ExtensiveInsertionSearch"/>
			<param name="mode" value="psav"/>
			<param name="stopDuration" value="60"/>
			<!-- Default faellt sonst auf Runtime.getRuntime().availableProcessors()
			     zurueck - explizit auf global/qsim numberOfThreads (6) begrenzt,
			     damit PSAV+SSAV nicht zusammen mehr Threads anfordern als
			     vorhanden. -->
			<param name="numberOfThreads" value="6"/>
			<param name="idleVehiclesReturnToDepots" value="true"/>
			<param name="useModeFilteredSubnetwork" value="true"/>
			<!-- Default ist true - genau diese Analyse/Output-Schreibvorgaenge
			     (occupancy_time_profiles etc.) sind zuletzt mit OOM abgestuerzt.
			     Aus fuer einen zuverlaessigen Lauf, spaeter bei Bedarf wieder an. -->
			<param name="writeDetailedCustomerStats" value="false"/>
			<param name="vehiclesFile" value="PLATZHALTER_wird_zur_Laufzeit_ueberschrieben.xml"/>

			<!-- gepooltes MOIA-artiges System: virtuelle Haltestellen statt
			     Door-to-Door (siehe alternatives.java). transitStopFile ist ein
			     Platzhalter, wird von behaviourModule.prepareDrtFleets(...) mit
			     einer aus dem Netzwerk generierten Haltestellendatei ueberschrieben. -->
			<param name="operationalScheme" value="stopbased"/>
			<param name="transitStopFile" value="PLATZHALTER_wird_zur_Laufzeit_ueberschrieben.xml"/>

			<!-- Cache fuer die Fahrzeit-Matrix: wird beim ersten Lauf erzeugt, danach
			     nur noch von der Platte gelesen statt bei jedem Lauf neu berechnet zu
			     werden - spart wiederholte Speicherspitzen (siehe Klassen-Kommentar
			     oben zum OOM-Verlauf). cache/ ist in .gitignore. -->
			<param name="travelTimeMatrixCachePath" value="cache/psav-ttmatrix.cache"/>

			<parameterset type="drtOptimizationConstraints">
				<!-- hoeher als SSAV: Pooling/Haltestellen-Routing braucht mehr Zeit -->
				<param name="maxWaitTime" value="900"/>
				<param name="maxTravelTimeAlpha" value="1.3"/>
				<param name="maxTravelTimeBeta" value="600"/>
				<!-- max. Fussweg zur naechsten virtuellen Haltestelle (stopbased) -->
				<param name="maxWalkDistance" value="1500.0"/>
			</parameterset>

			<parameterset type="rebalancing">
				<parameterset type="minCostFlowRebalancingStrategy">
					<param name="targetAlpha" value="0.5"/>
					<param name="targetBeta" value="0.5"/>
				</parameterset>
				<parameterset type="SquareGridZoneSystem">
					<param name="cellSize" value="6000"/>
				</parameterset>
			</parameterset>
		</parameterset>

		<parameterset type="drt">
			<parameterset type="ExtensiveInsertionSearch"/>
			<param name="mode" value="ssav"/>
			<param name="stopDuration" value="60"/>
			<!-- Default faellt sonst auf Runtime.getRuntime().availableProcessors()
			     zurueck - explizit auf global/qsim numberOfThreads (6) begrenzt,
			     damit PSAV+SSAV nicht zusammen mehr Threads anfordern als
			     vorhanden. -->
			<param name="numberOfThreads" value="6"/>
			<param name="idleVehiclesReturnToDepots" value="true"/>
			<param name="useModeFilteredSubnetwork" value="true"/>
			<!-- Default ist true - genau diese Analyse/Output-Schreibvorgaenge
			     (occupancy_time_profiles etc.) sind zuletzt mit OOM abgestuerzt.
			     Aus fuer einen zuverlaessigen Lauf, spaeter bei Bedarf wieder an. -->
			<param name="writeDetailedCustomerStats" value="false"/>
			<param name="vehiclesFile" value="PLATZHALTER_wird_zur_Laufzeit_ueberschrieben.xml"/>

			<!-- Door-to-Door-Robotaxi ohne Pooling (siehe alternatives.java) -
			     door2door ist zwar DRT-Default, hier explizit gesetzt zur
			     Dokumentation des Betriebskonzepts. capacity=1 kommt aus der
			     generierten Flottendatei (RunOberlausitzDresdenTest.SSAV_CAPACITY),
			     nicht von hier. -->
			<param name="operationalScheme" value="door2door"/>

			<!-- siehe PSAV-Kommentar oben zu travelTimeMatrixCachePath. -->
			<param name="travelTimeMatrixCachePath" value="cache/ssav-ttmatrix.cache"/>

			<parameterset type="drtOptimizationConstraints">
				<!-- niedriger als PSAV: direkter Dispatch ohne Pooling/Haltestellen -->
				<param name="maxWaitTime" value="600"/>
				<param name="maxTravelTimeAlpha" value="1.3"/>
				<param name="maxTravelTimeBeta" value="600"/>
			</parameterset>

			<parameterset type="rebalancing">
				<parameterset type="minCostFlowRebalancingStrategy">
					<param name="targetAlpha" value="0.5"/>
					<param name="targetBeta" value="0.5"/>
				</parameterset>
				<parameterset type="SquareGridZoneSystem">
					<param name="cellSize" value="6000"/>
				</parameterset>
			</parameterset>
		</parameterset>

	</module>

	<module name="transit">
		<param name="transitScheduleFile"
		       value="https://svn.vsp.tu-berlin.de/repos/public-svn/matsim/scenarios/countries/de/oberlausitz-dresden/oberlausitz-dresden-v2025.0/input/oberlausitz-dresden-v2025.0-transitSchedule.xml.gz"/>
		<param name="vehiclesFile"
		       value="https://svn.vsp.tu-berlin.de/repos/public-svn/matsim/scenarios/countries/de/oberlausitz-dresden/oberlausitz-dresden-v2025.0/input/oberlausitz-dresden-v2025.0-transitVehicles.xml.gz"/>
		<param name="useTransit" value="true"/>
	</module>

	<module name="routing">
		<param name="clearDefaultTeleportedModeParams" value="true"/>
		<param name="networkModes" value="car,ride,bike,longDistanceFreight"/>
		<parameterset type="teleportedModeParameters">
			<param name="beelineDistanceFactor" value="1.3"/>
			<param name="mode" value="walk"/>
			<param name="teleportedModeSpeed" value="1.0555556"/>
		</parameterset>
	</module>

	<module name="qsim">
		<param name="endTime" value="36:00:00"/>
		<param name="flowCapacityFactor" value="0.25"/>
		<param name="storageCapacityFactor" value="0.25"/>
		<param name="mainMode" value="car,longDistanceFreight,bike"/>
		<param name="numberOfThreads" value="6"/>
		<param name="startTime" value="00:00:00"/>
		<param name="stuckTime" value="30.0"/>
		<param name="trafficDynamics" value="kinematicWaves"/>
		<param name="linkDynamics" value="PassingQ"/>
		<param name="useLanes" value="false"/>

		<param name="vehiclesSource" value="modeVehicleTypesFromVehiclesData"/>
		<param name="insertingWaitingVehiclesBeforeDrivingVehicles" value="true"/>

		<!-- Schritt 8 (SAV-Flotte): von DRT/DVRP (DynAgents) verlangt - siehe
		     DynQSimConfigConsistencyChecker. -->
		<param name="simStarttimeInterpretation" value="onlyUseStarttime"/>

		<!-- Schritt 12: DrtConfigGroup warnt explizit davor, dass abgelehnte
		     DRT-Anfragen (postponed request rejection) die QSim ohne dieses
		     Setting endlos am Beenden hindern koennen ("stuck endlessly
		     waiting for a DRT vehicle"), wenn qsim.endTime gesetzt ist. -->
		<param name="simEndtimeInterpretation" value="onlyUseEndtime"/>
	</module>

	<module name="replanning">
		<param name="fractionOfIterationsToDisableInnovation" value="0.9"/>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ChangeExpBeta"/>
			<param name="subpopulation" value="person"/>
			<param name="weight" value="0.85"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="person"/>
			<param name="weight" value="0.10"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SubtourModeChoice"/>
			<param name="subpopulation" value="person"/>
			<param name="weight" value="0.10"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="TimeAllocationMutator"/>
			<param name="subpopulation" value="person"/>
			<param name="weight" value="0.10"/>
		</parameterset>

		<parameterset type="strategysettings">
			<param name="strategyName" value="ChangeExpBeta"/>
			<param name="subpopulation" value="longDistanceFreight"/>
			<param name="weight" value="0.95"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="longDistanceFreight"/>
			<param name="weight" value="0.05"/>
		</parameterset>
	</module>

	<module name="subtourModeChoice">
		<param name="chainBasedModes" value="car,bike"/>
		<param name="modes" value="car,ride,pt,bike,walk"/>
		<param name="considerCarAvailability" value="true"/>
		<param name="behavior" value="betweenAllAndFewerConstraints"/>
		<param name="probaForRandomSingleTripMode" value="0.5"/>
		<param name="coordDistance" value="100"/>
	</module>

	<module name="changeMode">
		<param name="modes" value="car,ride,pt,bike,walk"/>
		<param name="ignoreCarAvailability" value="true"/>
	</module>

	<module name="transitRouter">
		<param name="extensionRadius" value="500.0"/>
	</module>

	<module name="travelTimeCalculator">
		<param name="analyzedModes" value="car,longDistanceFreight"/>

		<!-- Not implemented for link2link routing -->
		<param name="separateModes" value="true"/>

		<!-- Needed for lane specific routing times -->
		<param name="calculateLinkToLinkTravelTimes" value="false"/>
		<param name="calculateLinkTravelTimes" value="true"/>
	</module>

	<module name="vspExperimental">
		<param name="vspDefaultsCheckingLevel" value="warn"/>
	</module>

	<module name="scoring">
		<param name="fractionOfIterationsToStartScoreMSA" value="1.0"/>
		<param name="writeExperiencedPlans" value="true"/>

		<parameterset type="scoringParameters">

			<param name="waitingPt" value="-2.0"/>

			<parameterset type="modeParams">
				<param name="constant" value="0.38240307139927565"/>
				<param name="marginalUtilityOfTraveling_util_hr" value="-0.5"/>
				<param name="mode" value="car"/>
				<param name="monetaryDistanceRate" value="-0.00025"/>
				<param name="dailyMonetaryConstant" value="-13.22"/>
			</parameterset>

			<parameterset type="modeParams">
				<param name="constant" value="-0.5121129798088191"/>
				<param name="dailyMonetaryConstant" value="0.0"/>
				<param name="dailyUtilityConstant" value="0.0"/>
				<param name="marginalUtilityOfDistance_util_m" value="0.0"/>
				<param name="marginalUtilityOfTraveling_util_hr" value="-0.5"/>
				<param name="mode" value="ride"/>
				<param name="monetaryDistanceRate" value="-2.0E-4"/>
			</parameterset>

			<parameterset type="modeParams">
				<param name="constant" value="-1.5493082137207121"/>
				<param name="dailyMonetaryConstant" value="0.0"/>
				<param name="dailyUtilityConstant" value="0.0"/>
				<param name="marginalUtilityOfDistance_util_m" value="0.0"/>
				<param name="marginalUtilityOfTraveling_util_hr" value="-3.5"/>
				<param name="mode" value="pt"/>
				<param name="monetaryDistanceRate" value="0.0"/>
			</parameterset>

			<parameterset type="modeParams">
				<param name="constant" value="-2.0444826912377856"/>
				<param name="dailyMonetaryConstant" value="0.0"/>
				<param name="dailyUtilityConstant" value="0.0"/>
				<param name="marginalUtilityOfDistance_util_m" value="0.0"/>
				<param name="marginalUtilityOfTraveling_util_hr" value="-4.0"/>
				<param name="mode" value="bike"/>
				<param name="monetaryDistanceRate" value="0.0"/>
			</parameterset>

			<parameterset type="modeParams">
				<param name="constant" value="0.0"/>
				<param name="dailyMonetaryConstant" value="0.0"/>
				<param name="dailyUtilityConstant" value="0.0"/>
				<param name="marginalUtilityOfDistance_util_m" value="0.0"/>
				<param name="marginalUtilityOfTraveling_util_hr" value="0.0"/>
				<param name="mode" value="walk"/>
				<param name="monetaryDistanceRate" value="0.0"/>
			</parameterset>

			<parameterset type="modeParams">
				<param name="constant" value="0.0"/>
				<param name="dailyMonetaryConstant" value="0.0"/>
				<param name="dailyUtilityConstant" value="0.0"/>
				<param name="marginalUtilityOfDistance_util_m" value="0.0"/>
				<param name="marginalUtilityOfTraveling_util_hr" value="-10.0"/>
				<param name="mode" value="longDistanceFreight"/>
				<param name="monetaryDistanceRate" value="-0.002"/>
			</parameterset>

		</parameterset>
	</module>

	<module name="transitRouter">
		<!-- Factor with which direct walk generalized cost is multiplied before it is compared to the pt generalized cost.  Set to a very high value to reduce direct walk results. -->
		<param name="directWalkFactor" value="1.0"/>
		<!-- maximum beeline distance between stops that agents could transfer to by walking -->
		<param name="maxBeelineWalkConnectionDistance" value="300.0"/>
	</module>
</config>
