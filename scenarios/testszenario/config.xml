<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>

    <!-- =========================================================================
         PARAMETER-SCHNITTSTELLE DES ADD-ONS

         GENERIERT von scenarios/testszenario/generate_config.py aus
         fertigeabmparameter.xlsx und ferigeSegmentierungParameter.xlsx -
         NICHT VON HAND BEARBEITEN. Werte aendern: Excel bearbeiten, dann
         `python3 scenarios/testszenario/generate_config.py`.

         Kosten (betaCost/-Niedrig/-Hoch): alle drei Excel-Einkommensspalten
         uebernommen (mittleres/niedriges/hohes Einkommen) - modeParams.draw
         (Random, incomeTier) waehlt je nach hhIncome-Klasse des Agenten
         (behaviourConfigGroup.resolveIncomeTier, Schwellenwerte
         einkommenSchwelleNiedrigMax/-HochMin unten) das passende Paar fuer
         die Mixed-Logit-Ziehung, siehe incomeTier-Klassen-Javadoc.
         betaCostNiedrigSd/betaCostHochSd nutzen dieselbe Streuung wie
         betaCostSd (Excel liefert keine eigene Streuung je Einkommensklasse).

         Zeit (betaInVehicleTime/betaWaitTime): Excel gibt je Minute an,
         hier auf je Stunde umgerechnet (x60) - Code/TripContext arbeiten
         durchgaengig mit Stunden.

         deltaByPreviousMode: NICHT mehr die volle asymmetrische Vormodus-
         Uebergangsmatrix aus der Excel, sondern nur noch der Diagonaleintrag
         (Modus -> sich selbst) mit einem einheitlichen Traegheitsbonus 0.831
         (Auftraggeber-Vorgabe) - jedes ModeParamSet traegt nur seinen eigenen
         Eintrag, alle anderen fehlen und liefern 0.0 (siehe modeParams.
         getDelta-Javadoc).

         Konstrukte: 11 SLR-Konstrukte (TAM/TPB/PMT), identisch benannt in
         gamma (fertigeabmparameter.xlsx, Konstrukt x Modus) und constructs/
         constructsSd (ferigeSegmentierungParameter.xlsx, Konstrukt x
         Cluster, M und SD der z-standardisierten Clusterwerte X*).

         Zwei Schichten:
           segmentParams = Profilschicht  (Segment -> latente Konstrukte X*, je mit Sd)
           modeParams    = Nutzenschicht  (Modus x Konstrukt -> gamma, je mit Sd)
         ========================================================================= -->

    <module name="verhaltensmodell">

        <param name="scaleParameter" value="1.0"/>
        <param name="randomSeed" value="4711"/>
        <param name="segmentAttribute" value="segment"/>
        <param name="ascNullKalibrierungAktiv" value="false"/>
        <param name="ascNullKalibrierungZielanteil" value="0.83"/>
        <param name="kandidatenwegAgentAnteil" value="0.20"/>
        <param name="einkommenSchwelleNiedrigMax" value="3"/>
        <param name="einkommenSchwelleHochMin" value="8"/>
        <!-- Einkommensstufe fuer die Kostensensitivitaet (betaCost/-Niedrig/-Hoch,
             siehe incomeTier-Klassen-Javadoc): hhIncome (1-10, VSP-Population)
             <= 3 -> NIEDRIG, >= 8 -> HOCH, sonst MITTEL. An der realen
             hhIncome-Verteilung der Oberlausitz/Dresden-Population orientiert
             (10pct-Lauf, 112.952 Agenten): Klassen 1-3 zusammen ~10,4% der
             Agenten, Klassen 8-10 zusammen ~14,5%, Klassen 4-7 (Mehrheit,
             ~75,1%) als "mittel" - kein amtlicher MiD/SrV-Schwellenwert. -->
        <param name="ascNull" value="-5.314434"/>
        <!-- Nullalternative im DCM (siehe behaviourCandidateTripInserter):
             ascNull per Schritt-9-Bisektion (behaviourCandidateTripInserter.
             calibrateAscNull(), verhaltensmodell.ascNullKalibrierungAktiv=true).
             NEUER ANSATZ (Auftraggeber-Vorgabe vom 2026-08-25, ersetzt die vorherige
             Kalibrierung -0.572000/25%): kandidatenwegAgentAnteil=0.20 - nur 20% der
             Agenten bekommen ueberhaupt einen Kandidatenweg angeboten (Rest bleibt
             unveraendert). Die Zielgroesse bezieht sich jetzt NICHT mehr nur auf die
             Kandidatenwege, sondern auf ALLE Wege (bestehende erhobene Wege JEDER
             Person PLUS die Kandidatenwege der 20%-Stichprobe) - "17% aller Wege
             werden (in der Basiswelt CA/PT) nicht genommen" -> ascNullKalibrierungZielanteil
             = 1 - 0.17 = 0.83 (Feld bleibt als WEG-Anteil definiert, siehe dortigen
             Javadoc). Erreicht 83.00% ueber 26599/32046 Wegen (ascnull_kalibrierung.csv
             eines 1pct-Kalibrierungslaufs vom 2026-08-25 - bewusst NUR ein schneller
             Korrektheitscheck, noch KEINE 10pct-Kalibrierung wie bei den vorherigen
             Werten; bei Bedarf spaeter mit groesserer Population wiederholen).
             Im AVM-Szenario (alle 5 Modi) mit diesem ascNull werden von der
             20%-Stichprobe ca. 87.8% tatsaechlich eingefuegt (1942/2212, 1pct-Testlauf)
             - hoeher als die 83% Basiswelt-Zielgroesse, da PSAV/SSAV/AV attraktiver
             sind als CA/PT allein (induzierte Nachfrage, wie bei den vorherigen
             Kalibrierungen beobachtet).
             Vorherige Werte (siehe Git-History): -0.572000 (25%-Ziel, nur
             Kandidatenwege, 100% der Agenten), -2.955578 (21%-Ziel), Platzhalter 1.12
             (~4% Zusatzweg-Quote, direkt im AVM-Szenario kalibriert).
             Nicht analytisch herleitbar wegen Mixed-Logit-Heterogenitaet (Softmax
             ueber heterogene Agentenpopulation ist nicht log-linear in ascNull).
             Bei Aenderungen an anderen modeParams/segmentParams-Werten, an der
             Kandidatenweg-Vorlagen-Wahl, an kandidatenwegAgentAnteil oder an der
             Population MUSS mit ascNullKalibrierungAktiv=true neu kalibriert werden.
             NICHT aus den Excel-Dateien, hier als Konstante gepflegt (wie
             scaleParameter/randomSeed/segmentAttribute). Der Zweck des Kandidatenwegs
             ergibt sich automatisch aus dem gewaehlten Nachbar-Weg, braucht daher
             keine eigene Zweck-Taxonomie-Konfiguration. -->
        <param name="ticketAttribute" value="ptTicket"/>
        <param name="ticketOwnedValue" value="full"/>
        <!-- Oberlausitz/Dresden liefert das Personenattribut "ptTicket" mit
             Werten "none"/"full" (~14% der Population "full") - siehe
             modeParams.costPerKmWithTicket-Javadoc fuer die Verwendung. -->
