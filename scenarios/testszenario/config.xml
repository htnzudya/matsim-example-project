<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>

    <!-- =========================================================================
         PARAMETER-SCHNITTSTELLE DES ADD-ONS

         Alle Koeffizienten des Verhaltensmodells stehen hier - nicht im Code.
         Eine spaetere Simulation rekalibriert ausschliesslich ueber diesen Block.

         !!! ACHTUNG !!!
         Saemtliche Zahlen unten sind ILLUSTRATIVE PLATZHALTER.
         Sie werden durch die aus der SLR extrahierten Koeffizienten ersetzt.
         Alle neu hinzugekommenen Variablen (die 8 neuen Konstrukte, alle
         Sigma-/Sd-Streuungen sowie betaWaitTime) stehen auf 0.

         Zwei Schichten:
           segmentParams = Profilschicht  (Segment -> latente Konstrukte X*, je mit Sd)
           modeParams    = Nutzenschicht  (Modus x Konstrukt -> gamma, je mit Sd)
         ========================================================================= -->

    <module name="verhaltensmodell">

        <param name="scaleParameter" value="1.0"/>
        <param name="randomSeed" value="4711"/>
        <param name="segmentAttribute" value="segment"/>

        <!-- ========== PROFILSCHICHT: Segment -> latente Konstrukte ==========
             konstrukte sind z-standardisiert (Mittelwert 0, Standardabweichung 1).
             Quelle (bestehende 4 Konstrukte): Cluster-Zentren (Mittelwerte M) der
             8-Cluster-Mobilitaetstypologie.

             Die insgesamt 12 Konstrukte:
               ptAffinity                  - Affinitaet zum OEPNV
               techAffinity                - mobilitaetsbezogene Technikaffinitaet
               carsharingAffinity          - Affinitaet zu Carsharing
               carAffinity                 - Affinitaet zum eigenen Auto
               socialNorm                  - soziale/subjektive Norm (TPB)
               perceivedBehaviouralControl - wahrgenommene Verhaltenskontrolle (TPB, PBC)
               attitude                    - Einstellung (TPB)
               safetyPerception            - Sicherheitswahrnehmung
               trust                       - Vertrauen
               perceivedRisk               - wahrgenommenes Risiko (Protection Motivation Theory)
               perceivedEaseOfUse          - Nutzungsfreundlichkeit (TAM, PEOU)
               perceivedUsefulness         - wahrgenommener Nutzen (TAM)

             constructsSd = Streuung je Konstrukt fuer agentenindividuelle Ziehungen
             (0 = alle Agenten eines Segments teilen denselben Konstruktwert).

             probability = Anteil dieses Segments an der Grundgesamtheit
             (Clustergroesse / n gesamt). Summe ueber alle 8 Segmente = 1,0.
               1 multioptionaler_urbanist        n=2.244   2,59%
               2 aktiver_aelterer                n=21.892 25,31%
               3 pragmatischer_urbanist          n=16.314 18,86%
               4 oepnv_gebundener                n=5.416   6,26%
               5 familienmitglied_mit_kindern    n=8.992  10,40%
               6 hochmobiler                     n=4.001   4,63%
               7 inaktiver_aelterer              n=10.425 12,05%
               8 laendlicher                     n=17.214 19,90%

             HINWEIS Carsharing-Affinitaet Cluster 1: M=5,75 (SD=1,93) liegt deutlich
             ausserhalb der Skala aller anderen Cluster (-0,11 bis -0,19). Wert wurde
             1:1 aus der Quelltabelle uebernommen, sollte aber gegen die Originalstudie
             geprueft werden.                                                    ========== -->

        <parameterset type="segmentParams">
            <param name="segmentId" value="multioptionaler_urbanist"/>
            <param name="probability" value="0.0259"/>
            <param name="constructs"
                   value="ptAffinity=0.68,techAffinity=0.61,carsharingAffinity=5.75,carAffinity=-0.19,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="constructsSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="segmentParams">
            <param name="segmentId" value="aktiver_aelterer"/>
            <param name="probability" value="0.2531"/>
            <param name="constructs"
                   value="ptAffinity=-0.37,techAffinity=-0.42,carsharingAffinity=-0.16,carAffinity=0.24,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="constructsSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="segmentParams">
            <param name="segmentId" value="pragmatischer_urbanist"/>
            <param name="probability" value="0.1886"/>
            <param name="constructs"
                   value="ptAffinity=0.81,techAffinity=0.34,carsharingAffinity=-0.11,carAffinity=-0.13,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="constructsSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="segmentParams">
            <param name="segmentId" value="oepnv_gebundener"/>
            <param name="probability" value="0.0626"/>
            <param name="constructs"
                   value="ptAffinity=0.96,techAffinity=-0.02,carsharingAffinity=-0.15,carAffinity=-2.61,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="constructsSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="segmentParams">
            <param name="segmentId" value="familienmitglied_mit_kindern"/>
            <param name="probability" value="0.1040"/>
            <param name="constructs"
                   value="ptAffinity=-0.23,techAffinity=0.29,carsharingAffinity=-0.15,carAffinity=0.19,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="constructsSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="segmentParams">
            <param name="segmentId" value="hochmobiler"/>
            <param name="probability" value="0.0463"/>
            <param name="constructs"
                   value="ptAffinity=-0.03,techAffinity=0.19,carsharingAffinity=-0.13,carAffinity=0.13,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="constructsSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="segmentParams">
            <param name="segmentId" value="inaktiver_aelterer"/>
            <param name="probability" value="0.1205"/>
            <param name="constructs"
                   value="ptAffinity=-0.24,techAffinity=-0.37,carsharingAffinity=-0.16,carAffinity=0.23,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="constructsSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="segmentParams">
            <param name="segmentId" value="laendlicher"/>
            <param name="probability" value="0.1990"/>
            <param name="constructs"
                   value="ptAffinity=-0.42,techAffinity=0.17,carsharingAffinity=-0.19,carAffinity=0.41,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="constructsSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <!-- ========== NUTZENSCHICHT: Koeffizienten je Alternative ==========
             asc                 = alternativenspezifische Konstante
             ascSd               = Streuung der ASC ueber Agenten (0 = kein Mixed Logit)
             betaInVehicleTime   = Grenznutzen der Im-Fahrzeug-Zeit in Nutzen pro Stunde
             betaInVehicleTimeSd = Streuung (Mean beta + SD beta aus der SLR-Aggregation)
             betaWaitTime        = Grenznutzen der Wartezeit in Nutzen pro Stunde
             betaWaitTimeSd      = Streuung von betaWaitTime
             betaCost            = Grenznutzen der Kosten in Nutzen pro Euro
             betaCostSd          = Streuung von betaCost
             costPerKm           = Tarif-/Betriebskostensatz in EURO PRO KILOMETER (kein
                                   Nutzenkoeffizient!). Die Simulation berechnet daraus
                                   costEuro = costPerKm * distanceKm aus der tatsaechlich
                                   gerouteten Distanz (siehe behaviourUtilityEstimator).
                                   KEINE Streuung - realer Tarifsatz, keine Praeferenz.
                                   Noch nicht befuellt (0.0): der beta_cost-Term bleibt
                                   wirkungslos, bis hier echte Euro/km-Saetze stehen.
             delta               = Traegheitsbonus, wenn dieser Modus zuletzt gewaehlt wurde (Habit)
             gamma               = Koeffizienten auf die latenten Konstrukte
                                   (TPB, TAM, Protection Motivation Theory)
             gammaSd             = Streuung je gamma-Koeffizient                 -->

        <!-- CA ist Referenzalternative: ASC auf 0 normiert -->
        <parameterset type="modeParams">
            <param name="mode" value="CA"/>
            <param name="asc" value="0.0"/>
            <param name="ascSd" value="0.0"/>
            <param name="betaInVehicleTime" value="-6.0"/>
            <param name="betaInVehicleTimeSd" value="1.5"/>
            <param name="betaWaitTime" value="0"/>
            <param name="betaWaitTimeSd" value="0"/>
            <param name="betaCost" value="-0.20"/>
            <param name="betaCostSd" value="0.05"/>
            <param name="costPerKm" value="0.0"/>
            <param name="delta" value="0.80"/>
            <param name="gamma"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0.50,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="gammaSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="modeParams">
            <param name="mode" value="AV"/>
            <param name="asc" value="-0.50"/>
            <param name="ascSd" value="0.60"/>
            <param name="betaInVehicleTime" value="-4.50"/>
            <param name="betaInVehicleTimeSd" value="1.20"/>
            <param name="betaWaitTime" value="0"/>
            <param name="betaWaitTimeSd" value="0"/>
            <param name="betaCost" value="-0.20"/>
            <param name="betaCostSd" value="0.05"/>
            <param name="costPerKm" value="0.0"/>

            <param name="delta" value="0.40"/>
            <param name="gamma"
                   value="ptAffinity=0,techAffinity=0.45,carsharingAffinity=0.30,carAffinity=0.20,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="gammaSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="modeParams">
            <param name="mode" value="PT"/>
            <param name="asc" value="-1.20"/>
            <param name="ascSd" value="0.50"/>
            <param name="betaInVehicleTime" value="-7.50"/>
            <param name="betaInVehicleTimeSd" value="1.80"/>
            <param name="betaWaitTime" value="0"/>
            <param name="betaWaitTimeSd" value="0"/>
            <param name="betaCost" value="-0.25"/>
            <param name="betaCostSd" value="0.06"/>
            <param name="costPerKm" value="0.0"/>
            <param name="delta" value="0.60"/>
            <param name="gamma"
                   value="ptAffinity=0.70,techAffinity=0,carsharingAffinity=0,carAffinity=-0.30,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="gammaSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

        <parameterset type="modeParams">
            <param name="mode" value="SAV"/>
            <param name="asc" value="-0.90"/>
            <param name="ascSd" value="0.70"/>
            <param name="betaInVehicleTime" value="-5.50"/>
            <param name="betaInVehicleTimeSd" value="1.40"/>
            <param name="betaWaitTime" value="0"/>
            <param name="betaWaitTimeSd" value="0"/>
            <param name="betaCost" value="-0.22"/>
            <param name="betaCostSd" value="0.05"/>
            <param name="costPerKm" value="0.0"/>
            <param name="delta" value="0.20"/>
            <param name="gamma"
                   value="ptAffinity=0,techAffinity=0.30,carsharingAffinity=0.55,carAffinity=-0.35,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
            <param name="gammaSd"
                   value="ptAffinity=0,techAffinity=0,carsharingAffinity=0,carAffinity=0,socialNorm=0,perceivedBehaviouralControl=0,attitude=0,safetyPerception=0,trust=0,perceivedRisk=0,perceivedEaseOfUse=0,perceivedUsefulness=0"/>
        </parameterset>

    </module>

</config>